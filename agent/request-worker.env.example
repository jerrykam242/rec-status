# rec-request-worker (see README.md, "Recording requests").
# Keep this file 0640 root:recstatus: it holds secrets.

# Status site (same key, origin IP and edge key as the agent in agent.env).
SYNC_URL=https://rec-status.example.com/__agent/sync
PUSH_KEY=
PUSH_CONNECT=198.51.100.20
PUSH_EDGE_KEY=

# OpenList account for the worker (create it in OpenList: base path /, permissions
# "Write content (mkdir)", "Copy" and "Share"; nothing else).
OPENLIST_URL=http://127.0.0.1:5244
OPENLIST_USER=rec-request
OPENLIST_PASSWORD=

LOCAL_ROOT=/local/openlist
GDRIVE_ROOT=/GDrive/录播
# More GDrive folders with the same layout, ";"-separated (older recordings).
EXTRA_ROOTS=/GDrive/Archive
SHARE_BASE=https://file.example.com
SHARE_DAYS=7
SHARE_MAX_ACCESS=10

# Mail. MAIL_MODE: graph (Microsoft Graph, recommended) | smtp (Exchange SMTP AUTH) | none.
ADMIN_EMAIL=admin@example.com
MAIL_MODE=none
MAIL_FROM=
# graph: Entra app registration with the Mail.Send application permission (admin consent).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# smtp: smtp.office365.com:587 with STARTTLS; SMTP AUTH must be enabled for the mailbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

POLL=10
ARCHIVE_EVERY=600
