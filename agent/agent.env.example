# /etc/rec-status/agent.env  (root:recstatus 0640)
REC_API=http://127.0.0.1:11419
REC_AUTH=user:password            # the recorder's Basic auth (same as rec_auth)
PUSH_URL=https://rec-status.example.com/__ingest
PUSH_KEY=<hex, same as gate/ingest_key on the status server>
PUSH_CONNECT=198.51.100.20        # optional: post straight to the origin (skips ESA)
PUSH_EDGE_KEY=<hex, same as gate/edge_key>   # needed with PUSH_CONNECT
WEBHOOK_BIND=172.19.0.1:2357      # gateway of the recorder's docker network (rec_default)
WEBHOOK_TOKEN=<random>            # recorder Webhook v2 URL: http://172.19.0.1:2357/hook/<token>
POLL_INTERVAL=10
HEARTBEAT=60
